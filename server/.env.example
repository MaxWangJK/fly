DATABASE_URL=postgresql+psycopg://fly:CHANGE_DATABASE_PASSWORD@postgres/fly
POSTGRES_PASSWORD=CHANGE_DATABASE_PASSWORD
JWT_PRIVATE_SECRET=CHANGE_TO_AT_LEAST_64_RANDOM_HEX_CHARACTERS
APP_ENV=production
STORAGE_ROOT=/var/lib/fly/storage
ALLOWED_HOSTS=world-workshop.cn,localhost,127.0.0.1
CORS_ORIGINS=
# Current cloud release: records only, for every user and every email.
CLOUD_FILE_TRANSFER_ENABLED=false
ALLOW_PASSWORD_AUTH=true
DEVICE_ENROLLMENT_ENABLED=true
SMTP_CONFIG_FILE=private/smtp.json
FILE_SYNC_ALLOWED_EMAILS=
ANALYTICS_ADMIN_USERNAME=admin
# Blank disables the dashboard. Set an independent random password (16+ chars).
ANALYTICS_ADMIN_PASSWORD=
# Native deployment: path to the existing website's public installer directory.
RELEASE_DIRECTORY=/var/www/fly/public/downloads
# Compose: host installer directory; mounted read-only at /var/lib/fly/releases.
FLY_RELEASES_DIR=../web/public/downloads
